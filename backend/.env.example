# ==============================================================================
# Smart Kirana Backend - Environment Configuration
# ==============================================================================

# Server Port
PORT=5000

# Environment Mode: 'development' | 'production' | 'test'
NODE_ENV=production

# Managed PostgreSQL Database URL (Supabase, Neon, AWS RDS, Render, etc.)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres?sslmode=require"

# Frontend Application Origin (Used for CORS and Cookie Domain Validation)
FRONTEND_URL="https://your-smart-kirana.vercel.app"

# Secret Key for Signing Session Cookies (HMAC-SHA256)
SESSION_SECRET="your-strong-random-session-secret-at-least-32-chars"

# Secret Key for Signing Short-Lived HMAC Links for Private Supplier Bills (FR-6.3)
BILL_SIGN_SECRET="your-strong-random-bill-signing-secret"

# Vision AI Configuration (Phase 5 - FR-6.4)
# Provider options: 'gemini' | 'openai' | 'tesseract' (default fallback)
VISION_API_PROVIDER="gemini"
VISION_API_KEY="your-gemini-vision-ai-api-key"
